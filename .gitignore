# store listing assets (generated marketing binaries; may contain user content).
# Only the binaries are ignored — the written submission notes in this folder are
# project docs and stay tracked. Note the directory itself must not be excluded,
# because git cannot re-include a file whose parent directory is ignored.
store/*.jpg
store/*.png

